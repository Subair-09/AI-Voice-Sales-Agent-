# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database: Persistent data store for orders, products, customers, call logs, and knowledge documents.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/baked_by_doja?retryWrites=true&w=majority"
MONGODB_DB_NAME="baked_by_doja"

# Cloudinary: Cloud asset storage and image CDN for bakery products, receipts, and knowledge attachments.
CLOUDINARY_CLOUD_NAME="baked-by-doja"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
# Alternatively, use the full connection string:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Resend: Transactional email delivery for order confirmations, customer receipts, and messages.
RESEND_API_KEY="your_resend_api_key"
RESEND_FROM_EMAIL="Baked by Doja <onboarding@resend.dev>"

# Vapi: Voice AI Agent platform for real-time WebRTC browser calls, outbound phone calls, and RAG voice sales.
VAPI_API_KEY="your_vapi_private_api_key"
VAPI_PUBLIC_KEY="your_vapi_public_key"
VITE_VAPI_PUBLIC_KEY="your_vapi_public_key"
VAPI_ASSISTANT_ID="your_vapi_assistant_id"
VAPI_PHONE_NUMBER_ID="your_vapi_phone_number_id"


